# Copy to .env (gitignored) and fill in real values.

# --- compose runtime ---------------------------------------------------------
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=sentinelx
POSTGRES_HOST_PORT=5432

REDIS_PASSWORD=please-change-me-too
REDIS_HOST_PORT=6379

SX_HTTP_PORT=8080
SX_METRICS_PORT=9090

# --- SentinelX config overrides (SENTINELX__<section>__<field>) -------------
# Each `__` becomes a nested level. These overlay values from the YAML file.
SENTINELX_CONFIG=./config/sentinelx.yaml

# Secrets — override here so the YAML file never contains them.
SENTINELX__DATABASE__URL=postgres://sentinelx:please-change-me@postgres:5432/sentinelx?sslmode=disable
SENTINELX__REDIS__URL=redis://:please-change-me-too@redis:6379/0
SENTINELX__JWT__SIGNING_KEY=please-change-me-to-a-base64-encoded-hs256-key-at-least-32-bytes-long==
