# Copy to `.env` next to docker-compose.yml. The compose file picks the
# .env up automatically. NEVER commit the real `.env` — it is .gitignored
# by the repository root .gitignore.
#
# All values below are DEV defaults: the same well-known strings the
# workspace ships in config/sentinelx.dev.example.yaml and the FOUND-001
# seed fixtures. They are safe to use on a laptop; rotate before any
# network-reachable deployment.

# --- Postgres -------------------------------------------------------------
PG_USER=sentinelx
PG_PASSWORD=sentinelx-local-pw
PG_DB=sentinelx

# Replication credentials — must match the literals in pg_primary/init.sql
# and pg_standby/standby-entrypoint.sh.
PG_REPL_USER=replicator
PG_REPL_PASSWORD=sentinelx-replica-pw
PG_REPL_SLOT=sx_standby_slot

# --- ClickHouse -----------------------------------------------------------
CH_USER=sentinelx
CH_PASSWORD=sentinelx-local-pw
CH_DB=sentinelx

# --- Bootstrap creds (must match tests/load/k6/*.js env defaults) ---------
SX_ADMIN_EMAIL=admin@sentinelx.dev
SX_ADMIN_PASSWORD=sentinelx-admin-pw
SX_TENANT_ID=01010101-0101-0101-0101-010101010101
