# ------------------------------------------------------------------
# SentinelX Dashboard — environment variables (copy to .env.local)
#
# Legend:
#   [public] — sent to the browser. Never put secrets here.
#   [server] — server-only, never exposed to the client bundle.
# ------------------------------------------------------------------

# [public] Base URL of sx-api (publicly exposed to the browser).
NEXT_PUBLIC_SX_API_URL=http://localhost:8080

# [public] Default tenant ULID used as the hidden default on the login form.
NEXT_PUBLIC_DEFAULT_TENANT_ID=01J0000000000000000000TENANT

# [public] Feature flag — when "true", the login page shows the
# email + password form alongside the SSO button. Defaults to "false".
# Forced off in production by lib/auth.ts regardless of this value.
NEXT_PUBLIC_ALLOW_CREDENTIALS_LOGIN=false

# ------------------------------------------------------------------
# Auth.js v5 / OIDC — server-only secrets, do NOT prefix with NEXT_PUBLIC.
# ------------------------------------------------------------------

# [server] 32+ byte random secret used to sign the session JWT.
#          Generate with: openssl rand -base64 32
AUTH_SECRET=

# [server] Canonical origin of this dashboard (Auth.js callback origin).
AUTH_URL=http://localhost:3000

# [server] OIDC discovery URL of your IdP. Examples:
#   Keycloak:  https://idp.example.com/realms/sentinelx
#   Auth0:     https://your-tenant.us.auth0.com
#   Okta:      https://your-tenant.okta.com/oauth2/default
OIDC_ISSUER=https://idp.example.com/realms/sentinelx

# [server] OIDC client credentials registered with the IdP.
# When ANY of OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET is unset,
# the OIDC provider is NOT registered and the "Sign in with SSO" button
# returns an error. Set all three to enable real SSO.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# [server] Space-separated OIDC scopes requested at login.
OIDC_SCOPES=openid profile email
